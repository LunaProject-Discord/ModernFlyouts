<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ModernFlyouts.WinUI.Controls.MediaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        WPF 0.10 session layout: source app + title/artist on the left, 64 px artwork on the right,
        transport controls at the bottom with "more" (shuffle/repeat/stop) on the left and the
        timeline toggle on the right; a thin progress bar until the seek bar is opened.
        Fluent spacing: 20 px side padding, 4 px control radius.
    -->
    <Grid>
    <!-- Artwork as a faded background (optional, as in the WPF version) -->
    <!-- Sized to the content in code, so the image never makes the panel taller -->
    <Image x:Name="BackgroundArtwork" Stretch="UniformToFill" Opacity="0.5" IsHitTestVisible="False"
           Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" />

    <StackPanel x:Name="ContentPanel" SizeChanged="ContentPanel_SizeChanged">
        <Grid Padding="20,16,20,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="InfoColumn" Width="*" />
                <ColumnDefinition x:Name="ArtworkColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="InfoGrid" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="SourcePanel" Orientation="Horizontal" Spacing="8">
                    <Image x:Name="SourceIcon" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="SourceName" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock x:Name="TitleText" Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock x:Name="ArtistText" Grid.Row="3" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border x:Name="ArtworkBorder" Grid.Column="1" Width="64" Height="64" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <Grid>
                    <FontIcon x:Name="ArtworkPlaceholder" Glyph="&#xE8D6;" FontSize="24"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Image x:Name="Artwork" Stretch="UniformToFill" />
                </Grid>
            </Border>
        </Grid>

        <!-- Timeline: thin progress until the seek bar is opened with the chevron -->
        <Grid x:Name="ProgressPanel" Padding="20,12,20,0">
            <ProgressBar x:Name="TimelineProgress" />
        </Grid>
        <Grid x:Name="SeekPanel" Padding="20,4,20,0" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="TimelineSlider" Grid.Column="1" IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                    ValueChanged="TimelineSlider_ValueChanged" />
            <TextBlock x:Name="DurationText" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Transport controls -->
        <Grid Height="56" Padding="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="MoreButton" Style="{StaticResource MediaToggleButtonStyle}"
                          HorizontalAlignment="Center" Checked="MoreButton_Toggled" Unchecked="MoreButton_Toggled">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
            </ToggleButton>

            <StackPanel x:Name="MainControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <Button x:Name="PreviousButton" Style="{StaticResource MediaButtonStyle}">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <Button x:Name="PlayPauseButton" Style="{StaticResource HighlightedMediaButtonStyle}">
                    <FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;" FontSize="16" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource MediaButtonStyle}">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
            </StackPanel>

            <StackPanel x:Name="MoreControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        Spacing="16" Visibility="Collapsed">
                <ToggleButton x:Name="ShuffleButton" Style="{StaticResource MediaToggleButtonStyle}">
                    <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="RepeatButton" Style="{StaticResource MediaToggleButtonStyle}">
                    <FontIcon x:Name="RepeatGlyph" Glyph="&#xE8EE;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="StopButton" Style="{StaticResource MediaButtonStyle}">
                    <FontIcon Glyph="&#xE71A;" FontSize="16" />
                </Button>
            </StackPanel>

            <ToggleButton x:Name="TimelineButton" Grid.Column="2" Style="{StaticResource MediaToggleButtonStyle}"
                          HorizontalAlignment="Center" Checked="TimelineButton_Toggled" Unchecked="TimelineButton_Toggled">
                <FontIcon x:Name="TimelineGlyph" Glyph="&#xE70E;" FontSize="12" />
            </ToggleButton>
        </Grid>
    </StackPanel>
    </Grid>
</UserControl>
