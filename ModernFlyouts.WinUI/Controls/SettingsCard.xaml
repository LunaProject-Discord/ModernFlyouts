<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ModernFlyouts.WinUI.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Margin="0,0,0,4">

    <!-- Windows 11 Settings-style row: icon, header/description, action on the right -->
    <Border MinHeight="68" Padding="16,12" CornerRadius="6" BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="IconElement" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="HeaderText" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </StackPanel>
            <ContentPresenter x:Name="ActionPresenter" Grid.Column="2" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
