<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ModernFlyouts.WinUI.Pages.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ModernFlyouts.WinUI.Controls"
    xmlns:res="using:ModernFlyouts.Properties">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
            <controls:SettingsCard Glyph="&#xE767;" Header="{x:Bind res:Strings.Settings_EnableModule_Audio}" Margin="0,8,0,4">
                <ToggleSwitch IsOn="{x:Bind S.AudioModuleEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <StackPanel IsHitTestVisible="{x:Bind S.AudioModuleEnabled, Mode=OneWay}"
                        Opacity="{x:Bind OpacityFor(S.AudioModuleEnabled), Mode=OneWay}">
                <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{x:Bind res:Strings.Settings_Modules_Audio_Media}" />

                <controls:SettingsCard Glyph="&#xE8D6;" Header="{x:Bind res:Strings.AudioFlyoutHelper_ShowGSMTCInVolumeFlyout}">
                    <ToggleSwitch IsOn="{x:Bind S.ShowMediaInVolumeFlyout, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Glyph="&#xE946;" Header="{x:Bind res:Strings.AudioFlyoutHelper_ShowPlayerInfo}">
                    <ToggleSwitch IsOn="{x:Bind S.ShowMediaPlayerInfo, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Glyph="&#xE768;" Header="{x:Bind res:Strings.AudioFlyoutHelper_ShowSeekbar}">
                    <ToggleSwitch IsOn="{x:Bind S.ShowMediaSeekbar, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="BackendCard" Glyph="&#xE9D9;" Header="{x:Bind res:Strings.AudioFlyoutHelper_EnhancedMediaBackend}">
                    <ComboBox x:Name="BackendCombo" MinWidth="200" />
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
