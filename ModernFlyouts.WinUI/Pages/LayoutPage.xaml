<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ModernFlyouts.WinUI.Pages.LayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:res="using:ModernFlyouts.Properties">

    <Page.Resources>
        <!-- One cell of the 3x3 position picker -->
        <Style x:Key="PositionCellStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <!-- The Grid gives the max-width panel a normal layout slot; directly inside the
             ScrollViewer it is centered by its desired width and overflows on wide windows. -->
        <Grid>
        <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{x:Bind res:Strings.Settings_FlyoutPlacement}" />

            <!-- Placement mode, with the settings of the chosen mode inside -->
            <toolkit:SettingsExpander x:Name="ModeCard" Header="{x:Bind res:Strings.Settings_FlyoutPlacementMode}" IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7C2;" /></toolkit:SettingsExpander.HeaderIcon>
                <ComboBox x:Name="ModeCombo" MinWidth="200" />
                <toolkit:SettingsExpander.Items>
                    <!-- Automatic placement -->
                    <toolkit:SettingsCard x:Name="PositionCard" Header="{x:Bind res:Strings.Settings_FlyoutPosition}">
                        <Grid x:Name="PositionGrid" RowSpacing="4" ColumnSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Name="MarginCard" Header="{x:Bind res:Strings.Settings_FlyoutMargin}">
                        <NumberBox x:Name="MarginBox" MinWidth="200" Minimum="0" Maximum="400"
                                   SmallChange="4" LargeChange="16" SpinButtonPlacementMode="Inline" />
                    </toolkit:SettingsCard>

                    <!-- Manual placement (after dragging the flyout) -->
                    <toolkit:SettingsCard x:Name="ExpandCard" Header="{x:Bind res:Strings.Settings_FlyoutExpandDirection}"
                                          Description="{x:Bind res:Strings.Settings_ExpandDirectionDescription}">
                        <ComboBox x:Name="ExpandCombo" MinWidth="200" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsCard Header="{x:Bind res:Strings.Settings_FlyoutContentStackingDirection}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8CB;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="StackingCombo" MinWidth="200" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{x:Bind res:Strings.Settings_Display}" />

            <toolkit:SettingsCard Header="{x:Bind res:Strings.Settings_DisplayDescription}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DisplayCombo" MinWidth="200" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Header="{x:Bind res:Strings.Settings_AlignFlyout}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B3;" /></toolkit:SettingsCard.HeaderIcon>
                <Button Content="{x:Bind res:Strings.Settings_AlignFlyout}" Click="PreviewButton_Click" />
            </toolkit:SettingsCard>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
