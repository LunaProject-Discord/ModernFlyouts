<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ModernFlyouts.WinUI.Pages.PersonalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ModernFlyouts.WinUI.Controls"
    xmlns:res="using:ModernFlyouts.Properties">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{x:Bind res:Strings.Settings_Appearance}" />

            <controls:SettingsCard Glyph="&#xE793;" Header="{x:Bind res:Strings.Settings_FlyoutTheme}">
                <ComboBox x:Name="FlyoutThemeCombo" MinWidth="200" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE790;" Header="{x:Bind res:Strings.Settings_AppTheme}">
                <ComboBox x:Name="AppThemeCombo" MinWidth="200" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE8A5;" Header="{x:Bind res:Strings.Settings_TrayIconEnabled}">
                <ToggleSwitch IsOn="{x:Bind S.TrayIconEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="{x:Bind res:Strings.Settings_Behavior}" />

            <controls:SettingsCard x:Name="TimeoutCard" Glyph="&#xE916;" Header="{x:Bind res:Strings.Settings_FlyoutTimeout}">
                <NumberBox x:Name="TimeoutBox" MinWidth="200" Minimum="500" Maximum="60000"
                           SmallChange="250" LargeChange="1000" SpinButtonPlacementMode="Inline" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
