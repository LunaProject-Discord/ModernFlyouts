<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ModernFlyouts.WinUI.Pages.ModuleTogglePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ModernFlyouts.WinUI.Controls">

    <!-- Used by modules whose only setting is on/off (brightness, airplane mode, virtual desktop). -->
    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPagePanelStyle}">
            <controls:SettingsCard x:Name="EnableCard" Margin="0,8,0,4">
                <ToggleSwitch x:Name="EnableSwitch" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
