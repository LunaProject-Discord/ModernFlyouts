<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModernFlyouts.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:ModernFlyouts.Properties">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- WinUI title bar (48 px as before): pane toggle, icon, title -->
        <TitleBar x:Name="AppTitleBar" Title="{x:Bind res:Strings.SettingsItem}" Height="48"
                  IsBackButtonVisible="False" IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Logo.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- The pane toggle lives in the title bar; the pane collapses on narrow windows -->
        <NavigationView x:Name="NavView" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="280"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" ExpandedModeThresholdWidth="800"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="general" Content="{x:Bind res:Strings.GeneralSettings}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="personalization" Content="{x:Bind res:Strings.Settings_Personalization}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="layout" Content="{x:Bind res:Strings.Settings_Layout}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="{x:Bind res:Strings.Settings_Modules}" />
                <NavigationViewItem Tag="audio" Content="{x:Bind res:Strings.Settings_Modules_Audio}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="brightness" Content="{x:Bind res:Strings.Settings_Modules_Brightness}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE706;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="airplane" Content="{x:Bind res:Strings.Settings_Modules_Airplane}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE709;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="lockkeys" Content="{x:Bind res:Strings.Settings_Modules_LockKeys}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="virtualdesktop" Content="{x:Bind res:Strings.Settings_Modules_VirtualDesktop}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="about" Content="{x:Bind res:Strings.About}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Same width as the page content (SettingsPagePanelStyle) so they line up on wide windows -->
                <TextBlock x:Name="HeaderText" Margin="40,24,40,8" MaxWidth="1000" Style="{StaticResource TitleTextBlockStyle}" />
                <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="ContentFrame_Navigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
