<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ModernFlyouts.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Settings pages (Windows 11 Settings-like spacing) -->
            <Style x:Key="SettingsPagePanelStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="40,0,40,24" />
                <Setter Property="MaxWidth" Value="1000" />
                <!-- Card spacing of WinUI Gallery / CommunityToolkit samples -->
                <Setter Property="Spacing" Value="4" />
            </Style>
            <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <!-- WinUI Gallery / Windows Settings section header spacing -->
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style>

            <!-- Flyout controls: WPF sizes (40x40 media buttons, 32 px top bar) with Fluent 4 px corners -->
            <Style x:Key="MediaButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <!-- Play/pause: filled like the WPF HighlightedMediaButtonStyle -->
            <Style x:Key="HighlightedMediaButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="MediaToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="FlyoutTopBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- Row icons: the full glyph in a faint tone behind the glyph of the current level -->
            <Style x:Key="FlyoutLevelGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style x:Key="FlyoutLevelShadowGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource FlyoutLevelGlyphStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>

            <Style x:Key="FlyoutValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontSize" Value="20" />
                <!-- Trim the line box to the glyphs so the digits sit exactly at the row's center -->
                <Setter Property="TextLineBounds" Value="Tight" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
