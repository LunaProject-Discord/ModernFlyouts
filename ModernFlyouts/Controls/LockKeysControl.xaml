<UserControl x:Class="ModernFlyouts.Controls.LockKeysControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:root="clr-namespace:ModernFlyouts"
             xmlns:ui="http://schemas.modernwpf.com/2019" xmlns:utils="clr-namespace:ModernFlyouts.Utilities"
             mc:Ignorable="d"
             Height="48" d:DesignWidth="354" DataContext="{x:Static root:FlyoutHandler.Instance}">

    <!-- Same 48 | * | 48 columns as the volume and brightness flyouts -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <ui:FontIcon x:Name="LockGlyph" Glyph="{x:Static utils:CommonGlyphs.Lock}" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="txt" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{DynamicResource BaseTextBlockStyle}" FontSize="16"
                   TextTrimming="CharacterEllipsis" Text="Lock key is on" />
    </Grid>

</UserControl>
