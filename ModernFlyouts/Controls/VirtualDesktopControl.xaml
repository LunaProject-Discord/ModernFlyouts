<UserControl x:Class="ModernFlyouts.Controls.VirtualDesktopControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:utils="clr-namespace:ModernFlyouts.Utilities"
             mc:Ignorable="d"
             Height="48" d:DesignWidth="354">

    <!-- Same 48 | * | 48 columns as the volume and brightness flyouts -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <ui:FontIcon Glyph="{x:Static utils:CommonGlyphs.TaskView}" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="NameTextBlock" Style="{DynamicResource BaseTextBlockStyle}" FontSize="15"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Desktop 1" />
            <ItemsControl x:Name="IndicatorItems" Margin="0,6,0,0" HorizontalAlignment="Center" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Dot" Width="6" Height="6" Margin="3,0" CornerRadius="3"
                            Background="{DynamicResource SystemControlForegroundBaseHighBrush}" Opacity="0.35" />
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding}" Value="True">
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            <Setter TargetName="Dot" Property="Width" Value="16" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
    </Grid>

</UserControl>
