<Page x:Class="ModernFlyouts.Navigation.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ModernFlyouts" xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:ModernFlyouts.Controls"
      xmlns:utils="clr-namespace:ModernFlyouts.Utilities"
      xmlns:resx="clr-namespace:ModernFlyouts.Properties"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800">
    <controls:ScrollViewerEx>
        <ui:SimpleStackPanel Spacing="10" Margin="20">
            <TextBlock FontWeight="SemiBold" Style="{DynamicResource TitleTextBlockStyle}"
                       Text="{x:Static local:Program.AppName}" />
            <Image Source="/Assets/Images/ModernFlyouts_128.png" HorizontalAlignment="Left" Height="128" />
            <TextBlock TextWrapping="Wrap" Text="{x:Static resx:Strings.About_AppDescription}" />
            <TextBlock>
                <Run Text="{x:Static resx:Strings.About_Version}" />
                <Bold>
                    <Run Text="{x:Static local:Program.AppVersion}" />
                </Bold>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                <Run FontWeight="SemiBold" Text="Personal combined build: " />
                <Run Text="based on the usoppii fork (.NET 10, ModernFlyouts 0.10 line) with the enhanced media backend from GlobalFlyouts (Astear17, Kinfani)." />
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0" Text="Credits" />
            <ui:HyperlinkButton Content="ModernFlyouts (original project)"
                                NavigateUri="https://github.com/ModernFlyouts-Community/ModernFlyouts" />
            <ui:HyperlinkButton Content="{x:Static resx:Strings.About_Contributors}"
                                NavigateUri="https://github.com/ModernFlyouts-Community/ModernFlyouts/graphs/contributors" />
            <ui:HyperlinkButton Content="usoppii/ModernFlyouts"
                                NavigateUri="https://github.com/usoppii/ModernFlyouts" />
            <ui:HyperlinkButton Content="Astear17/GlobalFlyouts"
                                NavigateUri="https://github.com/Astear17/GlobalFlyouts" />
            <ui:HyperlinkButton Content="Kinfani/GlobalFlyouts"
                                NavigateUri="https://github.com/Kinfani/GlobalFlyouts" />
        </ui:SimpleStackPanel>
    </controls:ScrollViewerEx>
</Page>
